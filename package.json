{
  "name": "@datacircle/langchain",
  "version": "0.1.0",
  "description": "LangChain.js tools on Datacircle's open API: find the best GTM APIs. List every API and see which provider ranks first on each one. Search every provider's pricing plans. See where a provider ranks. No API key needed.",
  "keywords": [
    "langchain",
    "langchainjs",
    "langchain-tools",
    "agent-tools",
    "tools",
    "gtm",
    "gtm-apis",
    "api",
    "api-directory",
    "api-pricing",
    "b2b-data",
    "data-enrichment",
    "datacircle"
  ],
  "homepage": "https://datacircle.dev",
  "bugs": {
    "url": "https://github.com/waynehamadi/langchainjs-datacircle/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waynehamadi/langchainjs-datacircle.git"
  },
  "license": "MIT",
  "author": "Datacircle <wayne@datacircle.dev> (https://datacircle.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "test": "npm run build && node test/live.mjs && node test/require.cjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
